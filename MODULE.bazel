module(
    name = "convert",
    version = "0.0.0",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
bazel_dep(name = "rules_shell", version = "0.6.1")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

bun_install = use_repo_rule("//tools/bun:install.bzl", "bun_install")

bun_install(
    name = "npm",
    extra_files = ["//:.npmrc"],
    lockfile = "//:bun.lock",
    package_json = "//:package.json",
)

# Third-party code. Each archive is pinned to a commit and copied whole into
# third_party/generated/<name> by //third_party:<name>; src imports it from
# there.
# To bump one: change the commit in `urls` and `strip_prefix`, clear
# `integrity`, build, and paste the hash Bazel prints.

http_archive(
    name = "envelope",
    build_file = "//third_party:all_files.BUILD.bazel",
    integrity = "sha256-kTvwjIwFiHCAntWxQseFnGProOFHzWgHpvEHgFPJJ3g=",
    strip_prefix = "envelope-2d8bc87d948ccfc391e86724bb0a5d7b1689d5c6",
    urls = ["https://github.com/p2r3/envelope/archive/2d8bc87d948ccfc391e86724bb0a5d7b1689d5c6.tar.gz"],
)

